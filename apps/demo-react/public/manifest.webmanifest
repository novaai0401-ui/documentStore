{
  "id": "/app",
  "lang": "en",
  "name": "Pyntra — universal document editor",
  "short_name": "Pyntra",
  "description": "Edit and convert PDF, Word, Excel, PowerPoint, Markdown, and more — 100% in your browser. Your files never leave your device.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#2e5bff",
  "categories": ["productivity", "utilities", "business"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Open a document", "short_name": "Open", "url": "/app" }
  ]
}
