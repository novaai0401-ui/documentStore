{
  "name": "@pdfcraft/ui-adapter-mui",
  "version": "1.0.0-rc.0",
  "description": "Material UI binding for @pdfcraft/ui-react's UIAdapter contract. Consumers using MUI get a styled dynamic form with one import.",
  "keywords": ["pdf", "pdf-form", "ui-adapter", "mui", "material-ui"],
  "homepage": "https://github.com/novaai0401-ui/editable-pdf#readme",
  "bugs": "https://github.com/novaai0401-ui/editable-pdf/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaai0401-ui/editable-pdf.git",
    "directory": "packages/pdf-ui-adapter-mui"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist/index.js", "dist/index.d.ts", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "echo 'no tests'",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@pdfcraft/ui-react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@mui/material": "^7.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
