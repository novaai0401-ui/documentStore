{
  "name": "@pdfcraft/ui-react",
  "version": "1.0.0-rc.0",
  "description": "Headless React bindings for @pdfcraft/engine. usePdfDocument + usePageRenderer hooks, a UIAdapter-driven DynamicForm, plus a CombInput primitive. No UI library shipped — bring your own via the 9-method UIAdapter contract.",
  "keywords": [
    "pdf",
    "react",
    "pdf-react",
    "headless-ui",
    "acroform",
    "pdf-form"
  ],
  "homepage": "https://github.com/novaai0401-ui/editable-pdf#readme",
  "bugs": "https://github.com/novaai0401-ui/editable-pdf/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaai0401-ui/editable-pdf.git",
    "directory": "packages/pdf-ui-react"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist/index.js", "dist/index.d.ts", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "echo 'no tests'",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@pdfcraft/engine": "workspace:*",
    "@pdfcraft/form-schema": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
