{
  "name": "@pdfcraft/engine",
  "version": "1.0.0-rc.0",
  "description": "Framework-agnostic PDF editing engine. pdf.js for rendering; @pdfcraft/parser for AcroForm read + incremental write. No pdf-lib in the runtime path.",
  "keywords": [
    "pdf",
    "pdf-editor",
    "pdfjs",
    "acroform",
    "pdf-form",
    "pdf-engine",
    "browser-pdf"
  ],
  "homepage": "https://github.com/novaai0401-ui/editable-pdf#readme",
  "bugs": "https://github.com/novaai0401-ui/editable-pdf/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaai0401-ui/editable-pdf.git",
    "directory": "packages/pdf-core-engine"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist/index.js", "dist/index.d.ts", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "echo 'no tests'",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@pdfcraft/parser": "workspace:*",
    "pdfjs-dist": "^4.9.155"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
